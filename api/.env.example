# Copy to .env and fill in. Never commit the real file.
PORT=4000
NODE_ENV=development

# A connection string for the database this instance owns. A madrasah running
# its own copy points this at its own cluster and shares nothing with anyone.
MONGO_URL=

# Signing secret for access tokens. Any long random string; rotating it signs
# everyone out, which is the intended emergency lever.
JWT_SECRET=

# Where the web app is served from, for CORS. Comma-separated.
WEB_ORIGIN=http://localhost:3000
