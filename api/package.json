{
  "name": "hifz-trail-api",
  "version": "0.1.0",
  "private": true,
  "description": "Accounts and durable storage for Hifz Trail. The app works without it.",
  "scripts": {
    "dev": "nodemon --watch . --ext ts --exec tsx index.ts",
    "start": "tsx index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "dev:memory": "tsx scripts/dev-memory.ts"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.0.1",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.3.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^22",
    "@types/supertest": "^6.0.2",
    "mongodb-memory-server": "^10.1.2",
    "nodemon": "^3.1.7",
    "supertest": "^7.0.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "mongodb-memory-server"
    ]
  }
}
